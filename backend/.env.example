# Market data source: yahoo (real daily bars, default) or synthetic (offline samples)
MARKET_DATA_SOURCE=yahoo
# Re-download at most once per this many hours, appending newly completed sessions
MARKET_DATA_REFRESH_HOURS=24
# Yahoo range: 1y, 2y, 5y ...
MARKET_HISTORY_RANGE=1y

# Boot mode: replay (historical) or live (real Yahoo quotes during the US session)
SIM_MODE=replay
# Live mode: poll real quotes every N seconds and let agents re-evaluate every M seconds
LIVE_POLL_SECONDS=60
LIVE_DECISION_SECONDS=300

# SQLite database file (defaults to backend/data/simulation.db)
DB_PATH=data/simulation.db
# Set to 0 to boot paused; 1 starts the replay immediately.
SIM_AUTOSTART=0
# Comma-separated exact browser origins allowed to call the API (no trailing slash).
# Use * only for a throwaway demo. Restart the service after changing this.
CORS_ORIGINS=https://your-dashboard.example.com,https://preview.example.com
LOG_LEVEL=INFO
