# Market data source: yahoo (real daily bars, default) or synthetic (offline samples)
MARKET_DATA_SOURCE=yahoo
# Re-download at most once per this many hours, appending newly completed sessions
MARKET_DATA_REFRESH_HOURS=24
# Yahoo range: 1y, 2y, 5y, 10y ... Changing it rebuilds the aligned cache.
MARKET_HISTORY_RANGE=5y

# Boot mode: replay (historical) or live (real Yahoo quotes during the US session)
SIM_MODE=replay
# Live mode: poll real quotes every N seconds and let agents re-evaluate every M seconds
LIVE_POLL_SECONDS=60
LIVE_DECISION_SECONDS=300

# Keep a free Render instance awake by requesting its own health endpoint.
# Render supplies RENDER_EXTERNAL_URL automatically; set KEEPALIVE_URL if not.
# Use 0 to disable the self-ping.
SELF_KEEPALIVE_SECONDS=60
# KEEPALIVE_URL=https://your-api.onrender.com/api/health

# SQLite database file (defaults to backend/data/simulation.db).
# Only use /var/data paths when a persistent disk is mounted at /var/data.
# Without a disk, omit DB_PATH/MODEL_DIR and let the app use its writable data dir.
DB_PATH=data/simulation.db
# Retrain the neural model automatically every this many replay bars once ready.
ML_RETRAIN_BARS=60
# Neural AI artifact directory (defaults to backend/data/models).
# Use a persistent disk in production; the free Render filesystem is ephemeral.
MODEL_DIR=data/models
# Train Neural AI automatically in live mode when no artifact exists.
ML_AUTOTRAIN=1
# Set to 0 to boot paused; 1 starts the replay immediately.
SIM_AUTOSTART=0
# Comma-separated exact browser origins allowed to call the API (no trailing slash).
# Use * only for a throwaway demo. Restart the service after changing this.
CORS_ORIGINS=https://your-dashboard.example.com,https://preview.example.com
LOG_LEVEL=INFO
