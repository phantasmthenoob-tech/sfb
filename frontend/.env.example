# Build-time settings for a statically hosted dashboard.
# Copy to .env.production.local (or set these in your host's build environment)
# and rebuild whenever they change. Vite only exposes variables prefixed VITE_.

# Base URL of the FastAPI backend (Render), no trailing slash.
VITE_API_BASE=https://ai-market-simulator-api.onrender.com

# Websocket endpoint on the same backend (wss:// in production).
VITE_WS_URL=wss://ai-market-simulator-api.onrender.com/ws/market
